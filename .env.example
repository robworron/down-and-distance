# Copy to .env and fill in values. Never commit .env.

# Local Postgres (docker-compose.yml)
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

# Database the pipeline and site connect to (local or Neon)
DATABASE_URL=

# Neon direct (unpooled) connection, for pipeline loads against production
NEON_DATABASE_URL=

# Neon pooled connection as the read-only web_reader role (Vercel's DATABASE_URL).
# Written by pipeline/create_web_reader.py.
WEB_READER_DATABASE_URL=
