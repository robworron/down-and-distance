# Copy to .env and fill in values. Never commit .env.

# Local Postgres (docker-compose.yml)
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

# Database the pipeline and site connect to (local or Neon)
DATABASE_URL=

# Neon direct (unpooled) connection, for pipeline loads against production
NEON_DATABASE_URL=

# Neon pooled connection as the read-only web_reader role (Vercel's DATABASE_URL).
# Written by pipeline/create_web_reader.py.
WEB_READER_DATABASE_URL=

# Bearer secret for the site's POST /api/revalidate (step 1.5). The same value
# goes in web/.env.local and in Vercel's Production environment variables.
REVALIDATE_SECRET=

# The live site's base URL, for `pipeline refresh` (optional: --site works too).
# In GitHub it's the repository variable SITE_URL.
SITE_URL=
